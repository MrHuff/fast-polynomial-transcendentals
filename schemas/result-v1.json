{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrHuff/fast-polynomial-transcendentals/raw/main/schemas/result-v1.json",
  "title": "Fast Polynomial Transcendentals result envelope, version 1",
  "description": "Common metadata envelope for newly generated fitting, kernel, component, and model measurements. Experiment-specific fields may be added inside the declared objects.",
  "type": "object",
  "required": [
    "schema_version",
    "experiment",
    "source",
    "environment",
    "measurement",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "description": {
          "type": "string"
        },
        "provenance_class": {
          "enum": [
            "new-measurement",
            "historical-materialized",
            "historical-source-derived",
            "blocked"
          ]
        },
        "created_utc": {
          "type": "string",
          "format": "date-time"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "git_revision": {
          "type": "string",
          "minLength": 1
        },
        "git_worktree_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "external_components": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "input_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "properties": {
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "device_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "compute_capability": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "python": {
          "type": [
            "string",
            "null"
          ]
        },
        "torch": {
          "type": [
            "string",
            "null"
          ]
        },
        "cuda": {
          "type": [
            "string",
            "null"
          ]
        },
        "torch_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "cuda_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "driver": {
          "type": [
            "string",
            "null"
          ]
        },
        "sm_clock_mhz": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "measurement": {
      "type": "object",
      "properties": {
        "dtype": {
          "type": "string"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "warmup": {
          "type": "integer",
          "minimum": 0
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "summary_statistic": {
          "type": "string"
        },
        "order_policy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "results": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "observation": {
      "type": "object",
      "properties": {
        "case": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "workload": {
          "type": "object",
          "additionalProperties": true
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "integer",
              "string",
              "boolean",
              "null",
              "array",
              "object"
            ]
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
